{
  "index_patterns": ["logs-techsupport-api-*"],
  "priority": 200,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "log": { "properties": { "level": { "type": "keyword" } } },
        "service": { "properties": { "name": { "type": "keyword" } } },
        "http": {
          "properties": {
            "request": { "properties": { "method": { "type": "keyword" } } },
            "response": { "properties": { "status_code": { "type": "integer" } } }
          }
        },
        "url": { "properties": { "path": { "type": "keyword" } } },
        "event": {
          "properties": {
            "duration": { "type": "long" },
            "category": { "type": "keyword" },
            "action": { "type": "keyword" }
          }
        },
        "trace": { "properties": { "id": { "type": "keyword" } } },
        "span": { "properties": { "id": { "type": "keyword" } } },
        "route": { "type": "keyword" },
        "client": { "properties": { "ip": { "type": "ip" } } },
        "user": { "properties": { "id": { "type": "keyword" }, "roles": { "type": "keyword" } } },
        "user_agent": { "properties": { "original": { "type": "keyword", "ignore_above": 1024 } } },
        "system": {
          "properties": {
            "process": {
              "properties": {
                "cpu": { "properties": { "total": { "properties": { "norm": { "properties": { "pct": { "type": "scaled_float", "scaling_factor": 10000 } } } } } } },
                "memory": { "properties": { "rss": { "properties": { "bytes": { "type": "long" } } } } }
              }
            }
          }
        },
        "nodejs": {
          "properties": {
            "memory": { "properties": { "heap": { "properties": { "used": { "properties": { "bytes": { "type": "long" } } }, "total": { "properties": { "bytes": { "type": "long" } } } } } } },
            "eventloop": {
              "properties": {
                "delay": { "properties": { "avg": { "properties": { "ms": { "type": "float" } } }, "p99": { "properties": { "ms": { "type": "float" } } } } },
                "utilization": { "properties": { "pct": { "type": "scaled_float", "scaling_factor": 10000 } } }
              }
            }
          }
        }
      }
    }
  }
}
